# Environment Configuration
# Copy this file to .env and fill in values

# HuggingFace token (optional — needed if model is gated)
HF_TOKEN=

# WandB API key (optional — for experiment tracking)
WANDB_API_KEY=
WANDB_PROJECT=answer-sheet-evaluation

# Paths (defaults are fine for most setups)
DATA_DIR=data/raw
OUTPUT_DIR=outputs
CACHE_DIR=data/processed
